# §4.2: monthly-only plan (decided) -- test mode until §4 ships.
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret
STRIPE_PRICE_ID_MONTHLY=price_1234567890

# Set to "true" once payments are ready to go live -- until then the
# Upgrade button is hidden/disabled and checkout is refused server-side.
# Leave unset (or anything other than "true") to keep payments off.
ENABLE_STRIPE=false

# Stripe's static, shareable Customer Portal login link (Settings -> Billing
# -> Customer portal in the Stripe dashboard). Fallback only -- signed-in
# users get a better one-click flow via /api/billing/portal (a real portal
# session for their specific customer, no email re-verification). This link
# is for someone who isn't logged into the app or can't access their
# account. Leave unset to hide the fallback link entirely.
STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/your_portal_id

# §1.5: transactional email (decided: Resend).
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Caliber <onboarding@resend.dev>"

# §2.8: analytics (decided: Plausible). Leave unset to disable tracking
# (local dev/tests no-op automatically).
PLAUSIBLE_DOMAIN=your-domain.com

# SMTP: used to email the site owner for both the waitlist and contact
# forms (app/api/waitlist, app/api/contact). CONTACT_TO_EMAIL is the
# inbox that receives both.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM="Caliber <no-reply@example.com>"
CONTACT_TO_EMAIL=you@example.com

# Set to "true" to show the "Join waitlist" button on the landing page.
# Leave unset (or anything other than "true") to hide it.
ENABLE_WAITLIST=false

# Set to "true" to require/send email verification (the dashboard nudge
# banner, the verification email at signup, and the resend endpoint).
# Leave unset (or anything other than "true") to skip it entirely --
# not needed for MVP. Unverified accounts are always fully usable either
# way; this only controls whether verification exists at all.
ENABLE_EMAIL_VERIFICATION=false

# Set to "true" to let users pick TikTok/X/Facebook/LinkedIn/Other as the
# audit platform. Leave unset (or anything other than "true") to lock the
# app to Instagram only -- hides the platform picker in the UI and the
# API route ignores any other value sent directly, so this can't be
# bypassed client-side.
ENABLE_OTHER_PLATFORMS=false