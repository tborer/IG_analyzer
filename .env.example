# Turso database (libSQL) — https://turso.tech
# TURSO_DATABASE_URL looks like: libsql://<db-name>-<org>.turso.io
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Random long string used to sign session cookies. Generate with:
#   openssl rand -base64 32
SESSION_SECRET=

# Anthropic API key — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
